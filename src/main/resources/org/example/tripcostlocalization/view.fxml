<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" alignment="CENTER" prefWidth="450.0" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.tripcostlocalization.Controller">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <VBox spacing="10.0">
        <children>
            <Label fx:id="lblDistance" text="Distance (km)" />
            <TextField fx:id="txtDistance" promptText="Trip distance in kilometers" />
        </children>
    </VBox>
    <VBox spacing="10.0">
        <children>
            <Label fx:id="lblConsumption" text="Fuel Consumption (L/100 km)" />
            <TextField fx:id="txtConsumption" promptText="Fuel consumption (L/100 km)" />
        </children>
    </VBox>
    <VBox spacing="10.0">
        <children>
            <Label fx:id="lblPrice" text="Fuel Price (per liter)" />
            <TextField fx:id="txtPrice" promptText="Fuel price per liter" />
        </children>
    </VBox>
    <Button fx:id="btnCalculate" mnemonicParsing="false" onAction="#calculateCost" text="Calculate Trip Cost" />
    <Label fx:id="lblResult" wrapText="true" />
    <VBox alignment="CENTER" spacing="10.0">
        <children>
            <Label fx:id="lblLanguage" text="Language" />
            <HBox alignment="CENTER" spacing="10.0">
                <children>
                    <Button mnemonicParsing="false" onAction="#setLanguage" text="EN" userData="EN" />
                    <Button mnemonicParsing="false" onAction="#setLanguage" text="FR" userData="FR" />
                    <Button mnemonicParsing="false" onAction="#setLanguage" text="JP" userData="JP" />
                    <Button mnemonicParsing="false" onAction="#setLanguage" text="IR" userData="IR" />
                </children>
            </HBox>
        </children>
    </VBox>
</VBox>

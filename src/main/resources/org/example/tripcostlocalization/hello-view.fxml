<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" prefWidth="450.0" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="org.example.tripcostlocalization.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Trip cost caluclator" />
   <VBox spacing="10.0">
      <children>
         <Label text="Distance (km)" />
         <TextField promptText="Trip distance in kilometers" />
      </children>
   </VBox>
   <VBox spacing="10.0">
      <children>
         <Label text="Fuel Consumption (L/100 km)" />
         <TextField promptText="Fuel consumption (L/100 km)" />
      </children>
   </VBox>
   <VBox spacing="10.0">
      <children>
         <Label text="Fuel Price (per liter)" />
         <TextField promptText="Fuel price per liter" />
      </children>
   </VBox>
   <Label />
   <Button mnemonicParsing="false" text="Calculate total fuel and cost" />
   <VBox alignment="CENTER" spacing="10.0">
      <children>
         <Label text="Language" />
         <HBox alignment="CENTER" spacing="10.0">
            <children>
               <Button mnemonicParsing="false" text="EN" />
               <Button mnemonicParsing="false" text="FR" />
               <Button mnemonicParsing="false" text="JP" />
               <Button mnemonicParsing="false" text="IR" />
            </children>
         </HBox>
      </children>
   </VBox>
</VBox>
